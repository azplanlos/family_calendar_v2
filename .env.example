CALENDAR_FEED=https://example.com/your-calendar-feed.ics

SCHOOL_CALENDAR_FEED=
VACATION_CALENDAR_FEED=https://www.feiertage-deutschland.de/kalender-download/ics/schulferien-bayern.ics

# Wechselmodell-Kalender (optional). Leer lassen => Feature inaktiv (kein Icon, keine Schraffur).
# CUSTODY_CALENDAR_FEED: iCal-Feed mit ganztaegigen Betreuungs-Events (Wechselmodell).
# CUSTODY_MALE_MATCH: Kennung im Event-Titel, die den Mann identifiziert (Teilstring,
#                     Gross-/Kleinschreibung egal). Titel ohne diese Kennung => Frau.
CUSTODY_CALENDAR_FEED=
CUSTODY_MALE_MATCH=

HOLIDAY_COUNTRY=de
HOLIDAY_STATE=by

# Zeitzone (IANA-ID) fuer "heute", Termin-Zeitraeume und den Footer "letzte Aktualisierung".
# Optional, Default: Europe/Berlin. Ungueltige Werte => Default.
TIMEZONE=Europe/Berlin

# OpenWeatherMap OneCall API 3.0
OPENWEATHER_API_KEY=your-api-key-here
OPENWEATHER_LAT=48.1351
OPENWEATHER_LON=11.5820

# Anonymisierter iCal-Feed (ServeAnonymizedFeed-Lambda).
# Liefert einen Quell-Feed aus, dessen private Event-Details durch einen Platzhalter ersetzt sind.
# ANON_SOURCE_FEED: Pflicht. Quell-iCal-URL (http/https), die anonymisiert ausgeliefert wird.
#                   Fehlt/ungueltig => Funktion antwortet mit 500.
# ANON_PARTICIPANT: optional. Name fuer X-WR-CALNAME des ausgelieferten Feeds (1..200 Zeichen);
#                   leer/zu lang => kein X-WR-CALNAME.
# ANON_PLACEHOLDER: optional. Ersatztext fuer private Titel/Details. Default: Privat.
#                   Als privat gilt CLASS:PRIVATE/CONFIDENTIAL ODER die Outlook-Kategorie "Privat".
#                   Tipp: Kategorie statt Privat-Flag nutzen, sonst maskiert Outlook den Titel
#                   schon im veroeffentlichten Feed (auch auf dem e-ink-Device).
# ANON_API_SECRET:  optional. Bearer-Token zum Schutz des Endpoints; leer => offener Zugriff.
# Hinweis: ANON_SOURCE_FEED und ANON_PARTICIPANT nutzt auch das e-ink-Rendering (CreateKalenderImage):
#          die Original-Outlook-Termine (unanonymisiert) werden zusaetzlich zu CALENDAR_FEED angezeigt
#          und ANON_PARTICIPANT zugeordnet.
ANON_SOURCE_FEED=https://example.com/your-private-feed.ics
ANON_PARTICIPANT=
ANON_PLACEHOLDER=Privat
ANON_API_SECRET=

# Outlook ueber Microsoft Graph (optional, persoenliches Microsoft-Konto).
# Ersetzt ANON_SOURCE_FEED als Quelle fuer die Outlook-Termine, wenn BEIDE Variablen
# GRAPH_CLIENT_ID und GRAPH_REFRESH_TOKEN_PARAM gesetzt (nicht leer) sind.
# Sind beide leer => Graph inaktiv, ANON_SOURCE_FEED wird wie bisher verwendet.
# Ist nur eine gesetzt => Warnung im Log, Graph bleibt inaktiv (ICS-Fallback).
# Den Refresh-Token selbst NIE hier eintragen; er liegt als SecureString im SSM Parameter Store
# und wird mit dem Bootstrap-Programm geschrieben.
#
# GRAPH_CLIENT_ID:           optional, Default: leer. Client-ID (Application ID) der App-Registrierung
#                            (oeffentlicher Client, kein Secret, delegiert Calendars.Read).
# GRAPH_REFRESH_TOKEN_PARAM: optional, Default: leer. Name des SSM-Parameters (SecureString)
#                            mit fuehrendem "/", z.B. /familienkalender/graph-refresh-token.
# GRAPH_HORIZON_DAYS:        optional, Default: 365. Ganze Zahl von 1 bis 730 (Tage ab jetzt).
#                            Wirkt nur auf den anonymisierten Feed (ServeAnonymizedFeed); das
#                            e-ink-Rendering nutzt ein festes Geraetefenster. Ungueltig => 365.
GRAPH_CLIENT_ID=
GRAPH_REFRESH_TOKEN_PARAM=
GRAPH_HORIZON_DAYS=365
