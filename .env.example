CALENDAR_FEED=https://example.com/your-calendar-feed.ics

SCHOOL_CALENDAR_FEED=
VACATION_CALENDAR_FEED=https://www.feiertage-deutschland.de/kalender-download/ics/schulferien-bayern.ics

# Wechselmodell-Kalender (optional). Leer lassen => Feature inaktiv (kein Icon, keine Schraffur).
# CUSTODY_CALENDAR_FEED: iCal-Feed mit ganztaegigen Betreuungs-Events (Wechselmodell).
# CUSTODY_MALE_MATCH: Kennung im Event-Titel, die den Mann identifiziert (Teilstring,
#                     Gross-/Kleinschreibung egal). Titel ohne diese Kennung => Frau.
CUSTODY_CALENDAR_FEED=
CUSTODY_MALE_MATCH=

HOLIDAY_COUNTRY=de
HOLIDAY_STATE=by

# OpenWeatherMap OneCall API 3.0
OPENWEATHER_API_KEY=your-api-key-here
OPENWEATHER_LAT=48.1351
OPENWEATHER_LON=11.5820

# Anonymisierter iCal-Feed (ServeAnonymizedFeed-Lambda).
# Liefert einen Quell-Feed aus, dessen private Event-Details durch einen Platzhalter ersetzt sind.
# ANON_SOURCE_FEED: Pflicht. Quell-iCal-URL (http/https), die anonymisiert ausgeliefert wird.
#                   Fehlt/ungueltig => Funktion antwortet mit 500.
# ANON_PARTICIPANT: optional. Name fuer X-WR-CALNAME des ausgelieferten Feeds (1..200 Zeichen);
#                   leer/zu lang => kein X-WR-CALNAME.
# ANON_PLACEHOLDER: optional. Ersatztext fuer private Titel/Details. Default: Privat.
# ANON_API_SECRET:  optional. Bearer-Token zum Schutz des Endpoints; leer => offener Zugriff.
ANON_SOURCE_FEED=https://example.com/your-private-feed.ics
ANON_PARTICIPANT=
ANON_PLACEHOLDER=Privat
ANON_API_SECRET=
